# Copy to `.env.local` and adjust as needed. Only variables prefixed with
# VITE_ are exposed to the client code (via import.meta.env).

# Base URL for backend requests. Leave empty to use the default `/api`, which
# the Vite dev server proxies to the backend (see vite.config.ts) and which a
# reverse proxy is expected to route in production.
VITE_API_URL=
