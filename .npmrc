# Supply-chain hardening. See the PR that introduced this file for rationale.

# Cooldown: refuse to install any dependency version published less than N days
# ago. Recent npm supply-chain worms (chalk/debug Sept 2025, Shai-Hulud, and the
# keyv/ChainDrop worm Aug 2026) were detected and yanked within ~2.5-12 hours,
# so a short cooldown blocks them before they can be installed. Installs from the
# committed lockfile (npm ci) are unaffected.
# NOTE: requires npm >= 11.10.0; older npm ignores this key (harmless no-op).
min-release-age=3

# Do not run package pre/post-install lifecycle scripts. Those worms execute
# their payload via a preinstall hook; disabling scripts neutralizes that vector.
# This project has no dependency that needs an install script.
# NOTE: this repo also has a yarn.lock. .npmrc only governs npm; for yarn
# installs enforce the equivalent (`yarn install --ignore-scripts`, or Yarn
# Berry `enableScripts: false`).
ignore-scripts=true
